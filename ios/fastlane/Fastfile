# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require "json"

default_platform(:ios)

APP_GROUP_ID = "group.com.deepblue.turathy"
MAIN_APP_ID = "com.deepblue.turathy"
LIVE_ACTIVITY_ID = "com.deepblue.turathy.LiveActivity"

def app_group_settings
  [{
    "key" => "APP_GROUPS",
    "options" => [{
      "key" => APP_GROUP_ID,
      "name" => "Turathy",
      "enabled" => true
    }]
  }]
end

# Creates the Live Activity App ID and turns on the shared App Group.
# create_capability adds one capability; it does not replace Push or Sign in with Apple.
def ensure_dynamic_island_ids
  live = Spaceship::ConnectAPI::BundleId.find(LIVE_ACTIVITY_ID)
  if live.nil?
    UI.message("Creating App ID #{LIVE_ACTIVITY_ID}")
    Spaceship::ConnectAPI::BundleId.create(
      name: "Turathy Live Activity",
      platform: "IOS",
      identifier: LIVE_ACTIVITY_ID
    )
  else
    UI.message("App ID #{LIVE_ACTIVITY_ID} already exists")
  end

  [LIVE_ACTIVITY_ID, MAIN_APP_ID].each do |identifier|
    bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
    UI.user_error!("App ID #{identifier} is missing on the developer portal") if bundle.nil?

    already = bundle.get_capabilities.any? { |cap| cap.capability_type == "APP_GROUPS" }
    if already
      UI.message("APP_GROUPS already enabled on #{identifier}")
      next
    end

    UI.message("Enabling #{APP_GROUP_ID} on #{identifier}")
    bundle.create_capability("APP_GROUPS", settings: app_group_settings)
  end
end

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 0. Setup CI environment (creates a temporary keychain on CI runners)
    setup_ci if ENV['CI']

    raw_key = ENV["APP_STORE_CONNECT_API_KEY"].to_s
    UI.user_error!("APP_STORE_CONNECT_API_KEY is not set") if raw_key.strip.empty?
    parsed = JSON.parse(raw_key)
    key_params = {
      key_id: parsed["key_id"],
      issuer_id: parsed["issuer_id"],
      duration: (parsed["duration"] || 1200).to_i,
      in_house: parsed["in_house"] == true
    }
    if parsed["key_filepath"].to_s != ""
      key_params[:key_filepath] = parsed["key_filepath"]
    else
      key_params[:key_content] = parsed["key"] || parsed["key_content"]
      key_params[:is_key_content_base64] = parsed["is_key_content_base64"] == true
    end
    api_key = app_store_connect_api_key(**key_params)

    # The Live Activity identifier does not exist yet. match cannot mint its profile until it does.
    ensure_dynamic_island_ids

    # 1. Sync certificates and profiles. force recreates them so the App Group is inside the profile.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: [MAIN_APP_ID, LIVE_ACTIVITY_ID],
      readonly: false,
      force: true
    )
    
    # 2. Ensure Pods are up to date
    cocoapods
    
    # 3. Increment build number based on the latest build on App Store Connect
    latest_build = latest_testflight_build_number(
      app_identifier: "com.deepblue.turathy",
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: latest_build + 1
    )
    
    # 4. Disable automatic signing ONLY for the Runner target (not Pods)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: "N6P5KD4Z98",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.deepblue.turathy"
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["LiveActivity"],
      team_id: "N6P5KD4Z98",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.deepblue.turathy.LiveActivity"
    )

    # 5. Archive only (skip IPA export — we need to patch App.framework first)
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      skip_package_ipa: true,
      clean: true
    )

    # 6. Patch App.framework/Info.plist — known Flutter bug: MinimumOSVersion is empty
    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    app_plist = "#{archive_path}/Products/Applications/Runner.app/Frameworks/App.framework/Info.plist"
    if File.exist?(app_plist)
      sh("plutil -replace MinimumOSVersion -string '15.0' \"#{app_plist}\" 2>/dev/null || plutil -insert MinimumOSVersion -string '15.0' \"#{app_plist}\"")
      UI.success("✅ Patched App.framework/Info.plist with MinimumOSVersion=15.0")
    else
      UI.important("⚠️  App.framework/Info.plist not found at #{app_plist}")
    end

    # 7. Export the patched archive into an IPA
    ipa_output_dir = File.expand_path("../build", Dir.pwd)
    sh("xcodebuild -exportArchive " \
       "-archivePath \"#{archive_path}\" " \
       "-exportPath \"#{ipa_output_dir}\" " \
       "-exportOptionsPlist \"#{File.expand_path('ExportOptions.plist', Dir.pwd)}\"")
    exported_ipa = Dir.glob("#{ipa_output_dir}/*.ipa").first
    lane_context[SharedValues::IPA_OUTPUT_PATH] = exported_ipa
    
    # 8. Upload the IPA to TestFlight
    upload_to_testflight(
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      distribute_external: false
    )
  end
end
